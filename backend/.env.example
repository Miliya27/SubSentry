# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./subsentry.db

# ── JWT ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email ─────────────────────────────────────────────────────────────
# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# EMAIL_MODE=console  → print reset link to terminal (DEV EMAIL label). Default.
# EMAIL_MODE=smtp     → send via STARTTLS SMTP using the vars below.
EMAIL_MODE=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@subsentry.com
